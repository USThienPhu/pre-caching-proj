# ==============================================================================
# SEMINAR CONFIGURATION (.env)
# ==============================================================================

# CHỌN PROVIDER ĐỂ ĐO LƯỜNG:
# 1) "unsloth_colab" : Gọi vLLM server đang chạy trên Google Colab (OpenAI-compatible)
# 2) "gemini"        : Gọi trực tiếp Google Gemini API
# 3) "replay"        : Chế độ phát lại benchmark (không cần server/key, cho red-team)
MEASURE_PROVIDER=unsloth_colab

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH DÀNH CHO UNSLOTH / VLLM TRÊN GOOGLE COLAB
# ------------------------------------------------------------------------------
# URL public được expose từ Colab (ngrok, cloudflared, hoặc localtunnel)
# Ví dụ: https://xxxx-xx-xx-xx.ngrok-free.app/v1
#        hoặc https://random-name.trycloudflare.com/v1
COLAB_VLLM_BASE_URL=https://YOUR_COLAB_TUNNEL_URL.ngrok-free.app/v1

# Tên model bạn load trong Colab (ví dụ: unsloth/Llama-3.2-3B-Instruct hoặc unsloth/mistral-7b-v0.3)
COLAB_MODEL_NAME=unsloth/Llama-3.2-3B-Instruct

# API Key của vLLM (Mặc định vLLM trên Colab không bắt buộc, điền gì cũng được hoặc đặt token ngrok)
COLAB_API_KEY=EMPTY

